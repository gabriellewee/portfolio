---
title: Front-end Developer, Designer, and Creative
description: I’m a front‑end developer working at Apple .
layout: layouts/base.njk
key: home
style: true
isotope: true
tags: pages
loading: Scroll to skip animation
pagination:
    data: collections.entries
    size: 16
    reverse: true
eleventyNavigation:
    key: Home
    order: 1
---

{% from "macros.njk" import author, buttons, contact, date, frame, header, indicator, meta, tablist, tabpanels, recipe, upscale, view %}
{% if pagination.pageNumber == 0 %}{{ contact(key, site.links) }}{% endif %}

<section class="content" aria-label="Posts">
	<div class="posts" data-grid data-scroll>
		{% for post in pagination.items %}
			{% set key = post.page.fileSlug %}
			{% if post.data.category == "code" %}
				{% set slug %}{{ post.page.date | iso | date('string') }}-{{ key }}{% endset %}
			{% elseif post.data.category == "cooking" %}
				{% set hero %}./static/images/{{ post.data.key }}/{{ key }}.jpg{% endset %}
			{% elseif post.data.category == "media" %}
				{% set file = post.data.extension %}
				{% if post.data.svg == true %}{% set file = "svg" %}{% endif %}
				{% set slug %}{{ post.data.date | safe }}-{{ post.data.name }}{% endset %}
				{% set mediaUrl %}/static/images/{{ key }}/{{ post.data.date }}-{{ post.data.name }}.{{ file }}{% endset %}
				{% set media %}.{{ mediaUrl }}{% endset %}
			{% endif %}
			{% set category %}post-{{ post.data.category }}{% endset %}
			{% if post.data.pagination.alias and post.data.pagination.alias != post.data.category %}
				{% set category %}post-{{ post.data.category }} post-{{ post.data.pagination.alias }}{% endset %}
			{% endif %}
			{% if post.data.tags %}
				{% set tags %}
					{% for tag in post.data.tags %}{% if tag != 'entries' and tag != 'posts' %} post-{{ tag }}{% endif %}{% endfor %}
				{% endset %}
			{% endif %}
			<article
				class="post {{ category }} {{tags}} {% if post.data.size %} post-size-{{ post.data.size }}{% endif %}{% if post.data.category == 'media' %} post-{{ key }}{% endif %}" data-grid-item data-post-append{% if pagination.pageNumber == 0 %} data-anim{% endif %}{% if post.data.extension %} data-orientation="{% stats media, 'orientation' %}"{% endif %}
				{% if post.data.width %}style="--max-width: {{ post.data.width }}"{% endif %}
				{% if post.data.category in ["social", "media"] %}aria-label="{{ (post.data.source or post.data.type) | capitalize }} post"{% endif %}
			>
				<div class="post-inner"{% if post.data.category == 'code' %} data-tablist{% endif %}>
					<header class="post-header{% if post.data.category in ['writing', 'code'] %} inline-header{% endif %}">
						{% if post.data.category == "cooking" %}
							<div class="post-header-image theme-{% stats hero, 'theme', 'bottom left' %}">
								{% image hero, 'Hero image showing ' ~ post.data.title, 'default', loop.index %}
							</div>
						{% endif %}
						{{ header(post.data, post, post.data.category, slug) }}
					</header>
					{% if post.data.category == "cooking" %}
						{{ recipe(post.data) }}
					{% elseif post.data.category == "code" %}
						{{ tablist(key, post.data) }}
					{% endif %}
					<div class="post-content{% if post.data.category in ['writing', 'cooking'] %} post-text{% endif %}"{% if post.data.background %} style="--background: {{ post.data.background }}"{% endif %}>
						{% if post.data.category == "media" %}
							<figure id="{{ slug }}" class="has-placeholder{% if file %} theme-{% stats media, 'theme', 'top left' %}{% endif %}" aria-label="{{ post.data.type | capitalize }}{% if post.data.location or post.data.title %}, {{ post.data.location or post.data.title }}{% endif %}"{% if post.data.description %} data-alt="{{ post.data.description }}"{% endif %} style="aspect-ratio:{% stats media, 'ratio' %}">
								{% if post.data.upscale %}
									{{ upscale(post.data) }}
								{% elseif post.data.svg == true %}
									<picture style="--background: {% if post.color %}{{ post.color }}{% else %}{% stats media, 'average' %}{% endif %}">
										<img src="{{ mediaUrl }}" alt="{{ post.description }}" width="{% stats media, 'width' %}" height="{% stats media, 'height' %}"/>
									</picture>
								{% else %}
									{% image media, post.data.description, 'default', loop.index %}
								{% endif %}
								{{ indicator() }}
								<figcaption class="media-data" data-focus-container>
									<details id="{{ slug }}-info" name="media-container" data-media-container>
										<summary data-focus>
											<span class="media-view-hover"><span class="button">
												<span aria-label="Information about this {{ post.data.type }}">View info</span>
											</span></span>
											<span class="media-view-touch" hidden></span>
											<span class="media-close media-icon" hidden></span>
										</summary>
										<div class="media-data-overlay">
											<div class="media-data-wrapper">
												{{ date(post.page) }}
												<label class="media-down media-icon" for="{{ slug }}-info" data-media-label></label>
												<div class="media-thumbnail">
													<a class="media-expand expand" href="#{{ slug }}-lightbox" role="button" aria-label="Expand image" data-media-expand>
														<span class="no-image" hidden><span>Expand</span></span>
														<span class="has-image{% if file %} theme-{% stats media, 'theme', 'top left' %}{% endif %}" aria-hidden="true" hidden>
															{% if post.data.upscale %}
																{{ upscale(post.data) }}
															{% elseif post.data.svg == true %}
																<picture style="--background: {% if post.color %}{{ post.color }}{% else %}{% stats media, 'average' %}{% endif %}">
																	<img src="{{ mediaUrl }}" alt="{{ post.description }}" width="{% stats media, 'width', 400 %}" height="{% stats media, 'height', 400 %}"/>
																</picture>
															{% else %}
																{% image media, post.data.description, 200, loop.index %}
															{% endif %}
														</span>
													</a>
												</div>
												{{ meta(post.data) }}
											</div>
										</div>
									</details>
								</figcaption>
							</figure>
						{% elseif post.data.category == "code" %}
							{{ buttons(post.data, post.url) }}
							<div id="tabpanel-{{ key }}-demo" class="post-tabpanel tabpanel-demo" role="tabpanel" data-tabpanel style="--height: {{ post.data.height }}px">
								{% if post.url %}
									{% set thumbnail %}/static/code/images/{{ key }}/thumbnail.svg{% endset %}
									{% if post.data.mobile == false %}
										<picture class="post-mobile">
											<img src="{{ thumbnail }}" alt="{{ post.description }}" width="{% stats '.' ~ thumbnail, 'width' %}" height="{% stats '.' ~ thumbnail, 'height' %}"/>
										</picture>
									{% endif %}
									{{ frame(post.data, post.url) }}
								{% else %}
									{{ post.content | safe }}
								{% endif %}
							</div>
							{{ tabpanels(key, post.data) }}
						{% elseif post.data.content %}
							<blockquote>{{ post.data.content | nbsp | md | safe }}</blockquote>
							{% set postIndex = loop.index %}
							{% if post.data.category == "social" %}
								{% if post.data.video or (post.data.mediaType == "VIDEO") %}
									{% if post.data.video %}
										{% set slug %}{{ postIndex }}-{{ post.data.video.cid | truncate(5, true, '') }}{% endset %}
										{% set width = post.data.video.aspectRatio.width %}
										{% set height = post.data.video.aspectRatio.height %}
									{% elseif post.data.mediaType == "VIDEO" %}
										{% set slug = post.data.id %}
										{% set width %}{% stats post.data.mediaThumbnail, 'width' %}{% endset %}
										{% set height %}{% stats post.data.mediaThumbnail, 'height' %}{% endset %}
									{% endif %}
									<figure id="external-{{ slug }}" class="media-attachment">
										<video width="{{ width }}" height="{{ height }}" controls preload="metadata" poster="{{ post.data.video.thumbnail or post.data.mediaThumbnail }}" aria-label="{{ post.data.video.alt }}">
											<source src="{{ post.data.video.playlist or post.data.mediaUrl }}" type="application/x-mpegURL">
										</video>
									</figure>
								{% endif %}
								{% if post.data.mediaType == "IMAGE" %}
									<figure id="external-{{ post.data.id }}" class="media-attachment has-placeholder theme-{% stats post.data.mediaUrl, 'theme', 'top left' %}" aria-label="{{ post.data.mediaAlt }}">
										<a class="expand theme-{% stats post.data.mediaUrl, 'theme', 'top left' %}" href="#external-{{ post.data.id }}-lightbox" role="button" aria-label="Expand image" data-media-expand>
											{% external post.data.mediaUrl, '', 500, 'lazy' %}
										</a>
										{{ indicator() }}
									</figure>
								{% endif %}
								{% for media in post.data.media %}
									{% set image = media.fullsize or media.url %}
									{% set alt = media.alt or media.description %}
									{% if media.fullsize %}
										{% set slug %}{{ postIndex }}-{{ post.data.cid | truncate(5, true, '') }}{% endset %}
									{% elseif media.url and (media.type != "gifv") %}
										{% set slug = media.id %}
									{% endif %}
									{% if media.fullsize or (media.url and (media.type != "gifv")) %}
										<figure id="external-{{ slug }}" class="media-attachment has-placeholder theme-{% stats image, 'theme', 'top left' %}" aria-label="{{ alt }}">
											<a class="expand theme-{% stats image, 'theme', 'top left' %}" href="#external-{{ slug }}-lightbox" role="button" aria-label="Expand image" data-media-expand>
												{% external image, '', 500, 'lazy' %}
											</a>
											{{ indicator() }}
										</figure>
									{% elseif media.url and media.type == "gifv" %}
										<figure id="external-{{ media.id }}" class="media-attachment">
											<video width="{{ media.meta.original.width }}" height="{{ media.meta.original.height }}" controls preload="metadata" poster="{{ media.preview_url }}" aria-label="{{ media.description }}">
												<source src="{{ media.url }}" type="video/mp4">
											</video>
										</figure>
									{% endif %}
								{% endfor %}
							{% endif %}
						{% else %}
							{% excerpt post %}
						{% endif %}
					</div>

					{% if post.data.category in ["writing", "social", "cooking"] %}
						<footer class="post-footer">
							{% if (post.data.category == "writing" and post.data.size != "s") or (post.data.category == "cooking") %}
								{% if post.url %}
									{{ view(post, post.data, title="Read " ~ (post.data.label or "post")) }}
								{% elseif post.data.url %}
									{% set label %}Read more{% if post.data.platform %} on {{ post.data.platform }}{% endif %}{% endset %}
									{{ view(post, post.data, title=label, type="reverse") }}
								{% endif %}
							{% elseif post.data.category == "social" %}
								{{ view(link, post.data, true, 'View post on') }}
							{% endif %}
							{% for link in post.data.external %}
								{{ view(link, post.data) }}
							{% endfor %}
							{% if post.data.archive == true %}
								{% if post.data.full == true %}
									{% set postSlug = post.data.title %}
								{% else %}
									{% set postSlug = key %}
								{% endif %}
								{% set url %}{{ site.url }}/v1/{{ post.page.date | iso | date('archive') }}/{{ postSlug | slugify }}{% endset %}
								{{ view(post, post.data, title="View original", url=url) }}
							{% endif %}
						</footer>
					{% endif %}
				</div>
				<hr class="no-css"/>
			</article>
		{% endfor %}
	</div>
	<nav class="pagination main-pagination" aria-label="Pagination">
		{% if pagination.href.next != null %}
			<div class="load">
				<div class="page-load-status" hidden>
					<p class="infinite-scroll-request">
						<span><span>Loading</span>{{ indicator() }}</span>
					</p>
					<p class="infinite-scroll-last">
						<span>You‘ve reached the end.</span>
					</p>
					<p class="infinite-scroll-error">
						<span>Oops! Please refresh and try again.</span>
					</p>
				</div>
				<button class="button" data-load hidden><span>Load more</span></button>
			</div>
		{% endif %}
		{% if pagination.href.previous and pagination.pageNumber != 0 %}
			<a class="newer button button-reverse" href="{{ pagination.href.previous }}"><span><span class="no-css">← </span>Newer</span></a>
		{% endif %}
		{% if pagination.href.next %}
			<a class="older button" href="{{ pagination.href.next }}" data-load-path><span>Older</span><span class="no-css"> →</span></a>
		{% endif %}
	</nav>
	<hr class="no-css"/>
</section>

{{ author(site) }}

<div class="lightbox-group" data-lightbox-container hidden>
	{% for post in pagination.items %}
		{% set key = post.page.fileSlug %}
		{% if post.data.category == "media" %}
			{% set file = post.data.extension %}
			{% if post.data.svg == true %}{% set file = "svg" %}{% endif %}
			{% set slug %}{{ post.data.date | safe }}-{{ post.data.name }}{% endset %}
			{% set mediaUrl %}/static/images/{{ key }}/{{ post.data.date }}-{{ post.data.name }}.{{ file }}{% endset %}
			{% set media %}.{{ mediaUrl }}{% endset %}
			<a class="lightbox" id="{{ slug }}-lightbox" role="button" aria-label="Close image" href="#{{ slug }}" tabindex="-1" data-lightbox data-lightbox-append></a>
			<dialog class="lightbox-content image" aria-label="Image preview" autofocus data-lightbox-append>
				<figure>
					{% if post.data.upscale %}
						{{ upscale(post.data) }}
					{% elseif post.data.svg == true %}
						<picture>
							<img src="{{ mediaUrl }}" alt="{{ post.description }}" width="{% stats media, 'width' %}" height="{% stats media, 'height' %}"/>
						</picture>
					{% else %}
						{% image media, post.data.description, 'screen' %}
					{% endif %}
				</figure>
			</dialog>
		{% elseif post.data.category == "social" and post.data.media %}
			{% set postIndex = loop.index %}
			{% for media in post.data.media %}
				{% set image = media.fullsize or media.url %}
				{% set alt = media.alt or media.description %}
				{% set width = media.aspectRatio.width or media.meta.original.width %}
				{% if media.fullSize %}
					{% set slug %}{{ postIndex }}-{{ post.data.cid | truncate(5, true, '') }}{% endset %}
				{% elseif media.url and media.type != "gifv" %}
					{% set slug = media.id %}
				{% endif %}
				<a class="lightbox" id="external-{{ slug }}-lightbox" role="button" aria-label="Close image" href="#external-{{ slug }}" tabindex="-1" data-lightbox data-lightbox-append></a>
				<dialog class="lightbox-content image" aria-label="Image preview" autofocus data-lightbox-append>
					<figure>
						{% external image, alt, width %}
					</figure>
				</dialog>
			{% endfor %}
		{% elseif post.data.category == "writing" %}
			{% excerpt post, "lightbox" %}
		{% elseif post.data.category == "code" %}
			{% set slug %}{{ post.page.date | iso | date('string') }}-{{ key }}{% endset %}
			{{ frame(post.data, post.url, "lightbox", slug) }}
		{% endif %}
	{% endfor %}
	<div class="lightbox-background"></div>
</div>