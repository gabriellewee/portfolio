---
title: Front-end Developer, Designer, and Creative
description: I’m a front‑end developer working at Apple .
layout: layouts/base.njk
key: home
style: true
isotope: true
tags: pages
loading: Scroll to skip animation
pagination:
    data: collections.entries
    size: 16
    reverse: true
eleventyNavigation:
    key: Home
    order: 1
---

{% from "macros.njk" import author, buttons, contact, date, frame, header, indicator, meta, tablist, tabpanels, recipe, upscale, view %}
{% if pagination.pageNumber == 0 %}{{ contact(key, site.links) }}{% endif %}

<section class="content" aria-label="Posts">
	<div class="posts" data-grid data-scroll>
		{% for post in pagination.items %}
			{% if post.data.svg == true %}
				{% set file = "svg" %}
			{% elseif post.data.extension %}
				{% set file = post.data.extension %}
			{% endif %}
			{% set key = post.page.fileSlug %}
			{% if post.data.category == "code" %}
				{% set slug %}{{post.page.date|iso|date('string')}}-{{key}}{% endset %}
			{% endif %}
			<article
				class="post{% if post.data.pagination.alias and post.data.pagination.alias != post.data.category %} post-{{post.data.category}} post-{{post.data.pagination.alias}}{% else %} post-{{post.data.category}}{% endif %}{% if post.data.tags %}{% for tag in post.data.tags %}{% if tag != 'entries' and tag != 'posts' %} post-{{tag}}{% endif %}{% endfor %}{% endif %}{% if post.data.size %} post-size-{{post.data.size}}{% endif %}{% if post.data.category == 'media' %} post-{{key}}{% endif %}" data-grid-item data-post-append{% if pagination.pageNumber == 0 %} data-anim{% endif %}{% if post.data.extension %} data-orientation="{% stats './static/images/' + key + '/' + post.data.date + '-' + post.data.name + '.' + file, 'orientation' %}"{% endif %}
				{% if post.data.width %}style="--max-width: {{post.data.width}}"{% endif %}
				{% if post.data.category == "social" %}aria-label="{{post.data.source|capitalize}} post"
				{% elseif post.data.category == "media" %}aria-label="{{post.data.type|capitalize}} post"{% endif %}
			>
				<div class="post-inner"{% if post.data.category == 'code' %} data-tablist{% endif %}>
					<header class="post-header{% if post.data.category == 'writing' or post.data.category == 'code' %} inline-header{% endif %}">
						{% if post.data.category == "cooking" %}
							<div class="post-header-image theme-{% stats './static/images/' + post.data.key + '/' + key + '.jpg', 'theme', 'bottom left' %}">
								{% image './static/images/' + post.data.key + '/' + key + '.jpg', 'Hero image showing ' + post.data.title, 'default', loop.index %}
							</div>
						{% endif %}
						{{ header(post.data, post, post.data.category, slug) }}
					</header>
					{% if post.data.category == "cooking" %}
						{{ recipe(post.data) }}
					{% elseif post.data.category == "code" %}
						{{ tablist(key, post.data) }}
					{% endif %}
					<div class="post-content{% if post.data.category == 'writing' or post.data.category == 'cooking' %} post-text{% endif %}"{% if post.data.background %} style="--background: {{post.data.background}}"{% endif %}>
						{% if post.data.category == "media" %}
							<figure id="{{post.data.date|safe}}-{{post.data.name}}" class="has-placeholder{% if file %} theme-{% stats './static/images/' + key + '/' + post.data.date + '-' + post.data.name + '.' + file, 'theme', 'top left' %}{% endif %}" aria-label="{{post.data.type|capitalize}}{% if post.data.location or post.data.title %}, {{post.data.location or post.data.title}}{% endif %}"{% if post.data.description %} data-alt="{{post.data.description}}"{% endif %} style="aspect-ratio:{% stats './static/images/' + key + '/' + post.data.date + '-' + post.data.name + '.' + file, 'ratio' %}">
								{% if post.data.upscale %}
									{{ upscale(post.data) }}
								{% elseif post.data.svg == true %}
									<picture style="--background: {% if post.color %}{{post.color}}{% else %}{% stats './static/images/' + key + '/' + post.data.date + '-' + post.data.name + '.svg', 'average' %}{% endif %}">
										<img src="/static/images/{{key}}/{{post.data.date}}-{{post.data.name}}.svg" alt="{{post.description}}" width="{% stats './static/images/' + key + '/' + post.data.date + '-' + post.data.name + '.svg', 'width' %}" height="{% stats './static/images/' + key + '/' + post.data.date + '-' + post.data.name + '.svg', 'height' %}"/>
									</picture>
								{% else %}
									{% image './static/images/' + key + '/' + post.data.date + '-' + post.data.name + '.' + post.data.extension, post.data.description, 'default', loop.index %}
								{% endif %}
								{{ indicator() }}
								<figcaption class="media-data" data-focus-container>
									<details id="{{post.data.date|safe}}-{{post.data.name}}-info" name="media-container" data-media-container>
										<summary data-focus>
											<span class="media-view-hover"><span class="button">
												<span aria-label="Information about this {{post.data.type}}">View info</span>
											</span></span>
											<span class="media-view-touch" hidden></span>
											<span class="media-close media-icon" hidden></span>
										</summary>
										<div class="media-data-overlay">
											<div class="media-data-wrapper">
												{{ date(post.page) }}
												<label class="media-down media-icon" for="{{post.data.date|safe}}-{{post.data.name}}-info" data-media-label></label>
												<div class="media-thumbnail">
													<a class="media-expand expand" href="#{{post.data.date|safe}}-{{post.data.name}}-lightbox" role="button" aria-label="Expand image" data-media-expand>
														<span class="no-image" hidden><span>Expand</span></span>
														<span class="has-image{% if file %} theme-{% stats './static/images/' + key + '/' + post.data.date + '-' + post.data.name + '.' + file, 'theme', 'top left' %}{% endif %}" aria-hidden="true" hidden>
															{% if post.data.upscale %}
																{{ upscale(post.data) }}
															{% elseif post.data.svg == true %}
																<picture style="--background: {% if post.color %}{{post.color}}{% else %}{% stats './static/images/' + key + '/' + post.data.date + '-' + post.data.name + '.svg', 'average' %}{% endif %}">
																	<img src="/static/images/{{key}}/{{post.data.date}}-{{post.data.name}}.svg" alt="{{post.description}}" width="{% stats './static/images/' + key + '/' + post.data.date + '-' + post.data.name + '.svg', 'width', 400 %}" height="{% stats './static/images/' + key + '/' + post.data.date + '-' + post.data.name + '.svg', 'height', 400 %}"/>
																</picture>
															{% else %}
																{% image './static/images/' + key + '/' + post.data.date + '-' + post.data.name + '.' + post.data.extension, post.data.description, 200, loop.index %}
															{% endif %}
														</span>
													</a>
												</div>
												{{ meta(post.data) }}
											</div>
										</div>
									</details>
								</figcaption>
							</figure>
						{% elseif post.data.category == "code" %}
							{{ buttons(post.data, post.url) }}
							<div id="tabpanel-{{key}}-demo" class="post-tabpanel tabpanel-demo" role="tabpanel" data-tabpanel style="--height: {{post.data.height}}px">
								{% if post.url %}
									{% set thumbnail %}/static/code/images/{{key}}/thumbnail.svg{% endset %}
									{% if post.data.mobile == false %}
										<picture class="post-mobile">
											<img src="{{thumbnail}}" alt="{{post.description}}" width="{% stats '.' ~ thumbnail, 'width' %}" height="{% stats '.' ~ thumbnail, 'height' %}"/>
										</picture>
									{% endif %}
									{{ frame(post.data, post.url) }}
								{% else %}
									{{post.content|safe}}
								{% endif %}
							</div>
							{{ tabpanels(key, post.data) }}
						{% elseif post.data.content %}
							<blockquote>{{post.data.content|nbsp|md|safe}}</blockquote>
							{% set postIndex = loop.index %}
							{% if post.data.category == "social" %}
								{% if post.data.video %}
									<figure id="external-{{postIndex}}-{{post.data.video.cid|truncate(5, true, '')}}" class="media-attachment">
										<video width="{{post.data.video.aspectRatio.width}}" height="{{post.data.video.aspectRatio.height}}" controls preload="metadata" poster="{{post.data.video.thumbnail}}" aria-label="{{post.data.video.alt}}">
											<source src="{{post.data.video.playlist}}" type="application/x-mpegURL">
										</video>
									</figure>
								{% endif %}
								{% if post.data.mediaType == "IMAGE" %}
									<figure id="external-{{post.data.id}}" class="media-attachment has-placeholder theme-{% stats post.data.mediaUrl, 'theme', 'top left' %}" aria-label="{{post.data.mediaAlt}}">
										<a class="expand theme-{% stats post.data.mediaUrl, 'theme', 'top left' %}" href="#external-{{post.data.id}}-lightbox" role="button" aria-label="Expand image" data-media-expand>
											{% external post.data.mediaUrl, '', 500, 'lazy' %}
										</a>
										{{ indicator() }}
									</figure>
								{% elseif post.data.mediaType == "VIDEO" %}
									<figure id="external-{{post.data.id}}" class="media-attachment">
										<video width="{% stats post.data.mediaThumbnail, 'width' %}" height="{% stats post.data.mediaThumbnail, 'height' %}" controls preload="metadata" poster="{{post.data.mediaThumbnail}}" aria-label="{{post.data.mediaAlt}}">
											<source src="{{post.data.mediaUrl}}" type="application/x-mpegURL">
										</video>
									</figure>
								{% endif %}
								{% for media in post.data.media %}
									{% if media.fullsize %}
										<figure id="external-{{postIndex}}-{{post.data.cid|truncate(5, true, '')}}" class="media-attachment has-placeholder theme-{% stats media.fullsize, 'theme', 'top left' %}" aria-label="{{media.alt}}">
											<a class="expand theme-{% stats media.fullsize, 'theme', 'top left' %}" href="#external-{{postIndex}}-{{post.data.cid|truncate(5, true, '')}}-lightbox" role="button" aria-label="Expand image" data-media-expand>
												{% external media.fullsize, '', 500, 'lazy' %}
											</a>
											{{ indicator() }}
										</figure>
									{% elseif media.url and media.type == "gifv" %}
										<figure id="external-{{media.id}}" class="media-attachment">
											<video width="{{media.meta.original.width}}" height="{{media.meta.original.height}}" controls preload="metadata" poster="{{media.preview_url}}" aria-label="{{media.description}}">
												<source src="{{media.url}}" type="video/mp4">
											</video>
										</figure>
									{% elseif media.url %}
										<figure id="external-{{media.id}}" class="media-attachment has-placeholder theme-{% stats media.url, 'theme', 'top left' %}" aria-label="{{media.description}}">
											<a class="expand theme-{% stats media.url, 'theme', 'top left' %}" href="#external-{{media.id}}-lightbox" role="button" aria-label="Expand image" data-media-expand>
												{% external media.url, '', 500, 'lazy' %}
											</a>
											{{ indicator() }}
										</figure>
									{% endif %}
								{% endfor %}
							{% endif %}
						{% else %}
							{% excerpt post %}
						{% endif %}
					</div>
					{% if post.data.category == "writing" or post.data.category == "social" or post.data.category == "cooking" %}
						<footer class="post-footer">
							{% if (post.data.category == "writing" and post.data.size != "s") or (post.data.category == "cooking") %}
								{% if post.url %}
									{{ view(post, post.data, title="Read " ~ (post.data.label or "post")) }}
								{% elseif post.data.url %}
									{% set label %}Read more{% if post.data.platform %} on {{ post.data.platform }}{% endif %}{% endset %}
									{{ view(post, post.data, title=label, type="reverse") }}
								{% endif %}
							{% elseif post.data.category == "social" %}
								{{ view(link, post.data, true, 'View post on') }}
							{% endif %}
							{% for link in post.data.external %}
								{{ view(link, post.data) }}
							{% endfor %}
							{% if post.data.archive == true %}
								{% if post.data.full == true %}
									{% set postSlug = post.data.title %}
								{% else %}
									{% set postSlug = key %}
								{% endif %}
								{% set url %}{{site.url}}/v1/{{post.page.date|iso|date('archive')}}/{{postSlug|slugify}}{% endset %}
								{{ view(post, post.data, title="View original", url=url) }}
							{% endif %}
						</footer>
					{% endif %}
				</div>
				<hr class="no-css"/>
			</article>
		{% endfor %}
	</div>
	<nav class="pagination main-pagination" aria-label="Pagination">
		{% if pagination.href.next != null %}
			<div class="load">
				<div class="page-load-status" hidden>
					<p class="infinite-scroll-request">
						<span><span>Loading</span>{{ indicator() }}</span>
					</p>
					<p class="infinite-scroll-last">
						<span>You‘ve reached the end.</span>
					</p>
					<p class="infinite-scroll-error">
						<span>Oops! Please refresh and try again.</span>
					</p>
				</div>
				<button class="button" data-load hidden><span>Load more</span></button>
			</div>
		{% endif %}
		{% if pagination.href.previous and pagination.pageNumber != 0 %}
			<a class="newer button button-reverse" href="{{pagination.href.previous}}"><span><span class="no-css">← </span>Newer</span></a>
		{% endif %}
		{% if pagination.href.next %}
			<a class="older button" href="{{pagination.href.next}}" data-load-path><span>Older</span><span class="no-css"> →</span></a>
		{% endif %}
	</nav>
	<hr class="no-css"/>
</section>

{{ author(site) }}

<div class="lightbox-group" data-lightbox-container hidden>
	{% for post in pagination.items %}
		{% set key = post.page.fileSlug %}
		{% if post.data.category == "code" %}
			{% set slug %}{{post.page.date|iso|date('string')}}-{{key}}{% endset %}
		{% endif %}
		{% if post.data.category == "media" %}
			<a class="lightbox" id="{{post.data.date|safe}}-{{post.data.name}}-lightbox" role="button" aria-label="Close image" href="#{{post.data.date|safe}}-{{post.data.name}}" tabindex="-1" data-lightbox data-lightbox-append></a>
			<dialog class="lightbox-content image" aria-label="Image preview" autofocus data-lightbox-append>
				<figure>
					{% if post.data.upscale %}
						{{ upscale(post.data) }}
					{% elseif post.data.svg == true %}
						<picture>
							<img src="/static/images/{{key}}/{{post.data.date}}-{{post.data.name}}.svg" alt="{{post.description}}" width="{% stats './static/images/' + key + '/' + post.data.date + '-' + post.data.name + '.svg', 'width' %}" height="{% stats './static/images/' + key + '/' + post.data.date + '-' + post.data.name + '.svg', 'height' %}"/>
						</picture>
					{% else %}
						{% image './static/images/' + key + '/' + post.data.date + '-' + post.data.name + '.' + post.data.extension, post.data.description, 'screen' %}
					{% endif %}
				</figure>
			</dialog>
		{% elseif post.data.category == "social" and post.data.media %}
			{% set postIndex = loop.index %}
			{% for media in post.data.media %}
				{% if media.fullsize %}
					<a class="lightbox" id="external-{{postIndex}}-{{post.data.cid|truncate(5, true, '')}}-lightbox" role="button" aria-label="Close image" href="#external-{{postIndex}}-{{post.data.cid|truncate(5, true, '')}}" tabindex="-1" data-lightbox data-lightbox-append></a>
					<dialog class="lightbox-content image" aria-label="Image preview" autofocus data-lightbox-append>
						<figure>
							{% external media.fullsize, media.alt, media.aspectRatio.width %}
						</figure>
					</dialog>
				{% elseif media.url and media.type != "gifv" %}
					<a class="lightbox" id="external-{{media.id}}-lightbox" role="button" aria-label="Close image" href="#external-{{media.id}}" data-lightbox data-lightbox-append></a>
					<dialog class="lightbox-content image" aria-label="Image preview" autofocus data-lightbox-append>
						<figure>
							{% external media.url, media.description, media.meta.original.width %}
						</figure>
					</dialog>
				{% endif %}
			{% endfor %}
		{% elseif post.data.category == "writing" %}
			{% excerpt post, "lightbox" %}
		{% elseif post.data.category == "code" %}
			<a class="lightbox" id="{{slug}}-lightbox" role="button" aria-label="Close preview of {{post.data.title}}" href="#{{slug}}" tabindex="-1" data-lightbox data-lightbox-append data-desktop></a>
			<dialog class="lightbox-content iframe" aria-label="Preview of {{post.data.title}}" autofocus data-lightbox-append>
				{{ frame(post.data, post.url) }}
			</dialog>
		{% endif %}
	{% endfor %}
	<div class="lightbox-background"></div>
</div>