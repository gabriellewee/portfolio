{% macro indicator() %}
	<span class="indicator"><span></span><span></span><span></span></span>
{% endmacro %}

{% macro header(src, time, category) %}
	<div class="post-header-content">
		{% if category == "writing" or category == "cooking" %}
			<h2>
				{% if post.url %}
					<a href="{{post.url|url}}"{% if category == "cooking" %} aria-label="Recipe for {{src.title|safe}}"{% endif %}><span><span>{{src.title|safe}}</span></span></a>
				{% else %}
					<a href="{{src.url|url}}"><span><span>{{src.title|safe}}</span></span></a>
				{% endif %}
			</h2>
		{% elseif category == "code" %}
			<div class="post-header-left">
				<h2 class="post-headline">
					{% if src.uri %}
						<a href="https://codepen.io/gabriellewee/pen/{{src.uri}}"><span>{{src.title|safe}}</span></a>
					{% else %}
						{{src.title|safe}}
					{% endif %}
				</h2>
				{% if src.type %}
					<div class="post-tags">
						{% for type in src.type %}
							<u class="tag-{{type}}">#{{type}}</u>
						{% endfor %}
					</div>
				{% endif %}
			</div>
		{% endif %}
		{% if category == "code" %}
			<div class="post-header-right">
				<time class="time{% if category != 'code' %} time-default{% endif %}{% if category == 'social' %} time-external{% endif %}" datetime="{{time.date|iso|date('string')}}" data-time="{{time.date|iso}}" title="{{time.date|iso|date('readable')}}">{{time.date|iso|date('readable')}}</time>
				<a class="expand" id="{{time.date|iso|date('string')}}-{{key}}" role="button" aria-label="Expand preview of {{src.title}}" href="#{{time.date|iso|date('string')}}-{{key}}-lightbox" data-media-expand data-desktop></a>
				<a class="external-expand" href="{{post.url|url}}" aria-label="View {{category}} in new window" target="_blank"></a>
			</div>
		{% elseif category != "media" and category != "code" %}
			<time class="time{% if category != 'code' %} time-default{% endif %}{% if category == 'social' %} time-external{% endif %}" datetime="{{time.date|iso|date('string')}}" data-time="{{time.date|iso}}" title="{{time.date|iso|date('readable')}}">{{time.date|iso|date('readable')}}</time>
		{% endif %}
		{% if category == "media" %}
			<time class="no-css" datetime="{{time.date|iso|date('string')}}">{{time.date|iso|date('readable')}}</time>
		{% endif %}
	</div>
{% endmacro %}

{% macro upscale(src) %}
	<picture{% if src.color %} style="--background: {{post.color}}"{% endif %}>
		<img class="upscale" src="{% include src.upscale %}"{% if src.upscaleWidth %} width="{{src.upscaleWidth}}"{% endif %}{% if src.upscaleHeight %} height="{{src.upscaleHeight}}"{% endif %} alt="{{src.description}}"/>
	</picture>
{% endmacro %}

{% macro meta(src) %}
	{% if src.external %}
		<div class="media-links">
			{% for link in src.external %}
				<a class="media-link external {{link.platform}}" href="{{link.url|url}}" tabindex="-1" aria-label="View on {{link.platform|capitalize}}" data-media-external><span><span class="no-css">View on </span>{{link.platform|capitalize}}</span></a>
			{% endfor %}
		</div>
	{% endif %}
	<dl class="media-meta">
		{% if src.title %}
			<div class="meta-title">
				<dt>Title</dt><dd>{{src.title|nbsp|safe}}</dd>
			</div>
		{% endif %}
		{% if src.location %}
			<div class="meta-location">
				<dt>Location</dt><dd>{{src.location}}</dd>
			</div>
		{% endif %}
		{% if src.camera %}
			<div class="meta-camera">
				<dt>Camera</dt><dd>{{src.camera}}</dd>
			</div>
		{% endif %}
		{% if src.editor %}
			<div class="meta-editor">
				<dt>Editor</dt><dd>{{src.editor}}</dd>
			</div>
		{% endif %}
		{% if src.tools %}
			<div class="meta-tools">
				<dt>Tools</dt><dd>{{src.tools}}</dd>
			</div>
		{% endif %}
	</dl>
{% endmacro %}

{% macro code(src) %}
	{% if src.mobile == false %}
		<a class="post-mobile-button button" href="{{post.url|url}}" target="_blank"><span>View animation</span></a>
	{% endif %}
	{% if src.button %}
		<button class="reload button" data-reload hidden><span>{{src.button|capitalize}}</span></button>
	{% endif %}
{% endmacro %}

{% macro recipe(src) %}
	<aside class="post-meta">
		{% if src.servings %}
			<p class="recipe-servings"><strong>Servings:</strong> <span>{{src.servings}}</span></p>
		{% endif %}
		{% if src.prep %}
			<p class="recipe-prep"><strong>Prep:</strong> <span class="recipe-duration" data-duration="{{src.prep}}">{{src.prep}} minutes</span></p>
		{% endif %}
		{% if src.cook %}
			<p class="recipe-cook"><strong>Cook:</strong> <span class="recipe-duration" data-duration="{{src.cook}}">{{src.cook}} minutes</span></p>
		{% endif %}
		{% if src.prep and src.cook %}
			{% set total = [src.prep,src.cook] %}
			<p class="recipe-total"><strong>Total:</strong> <span class="recipe-duration" data-duration="{{total|sum}}">{{total|sum}} minutes</span></p>
		{% endif %}
	</aside>
{% endmacro %}